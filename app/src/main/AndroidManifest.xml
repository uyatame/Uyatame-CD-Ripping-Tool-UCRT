        </activity-alias>
        <activity-alias
            android:name=".LauncherAlias_ucrt4_dark"
            android:enabled="false"
            android:exported="true"
            android:label="@string/launcher_name"
            android:icon="@mipmap/ic_alt_ucrt4_dark"
            android:roundIcon="@mipmap/ic_alt_ucrt4_dark"
