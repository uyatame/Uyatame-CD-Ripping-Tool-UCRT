            android:icon="@mipmap/ic_alt_ucrt3_dark"
            android:roundIcon="@mipmap/ic_alt_ucrt3_dark"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherAlias_ucrt4_light"
            android:enabled="false"
            android:exported="true"
            android:label="@string/launcher_name"
            android:icon="@mipmap/ic_alt_ucrt4_light"
            android:roundIcon="@mipmap/ic_alt_ucrt4_light"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
