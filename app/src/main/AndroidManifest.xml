                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherAlias_rainbow_unknown"
            android:enabled="false"
            android:exported="true"
            android:label="@string/launcher_name"
            android:icon="@mipmap/ic_alt_rainbow_unknown"
            android:roundIcon="@mipmap/ic_alt_rainbow_unknown"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Spotify のログインをブラウザで行ったときに、戻ってくるところ(ucrt-spotify://callback)。
             Spotify 公式の認証ライブラリの画面で、5.0.0 からはアプリ側で宣言する -->
        <activity
            android:name="com.spotify.sdk.android.auth.browser.RedirectUriReceiverActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ucrt-spotify" android:host="callback" />
            </intent-filter>
        </activity>

        <!-- 曲情報を MusicBrainz に登録する画面(MusicBrainz の登録画面を、曲情報を入れた状態で開く) -->
        <activity
            android:name=".MusicBrainzSubmitActivity"
            android:exported="false"
            android:label="MusicBrainz"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />
        <!-- MusicBrainz にジャケット画像を登録するとき、アプリの中のブラウザに画像を渡すため(アプリのキャッシュの mb-cover だけ) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- ネットワーク(NAS など)の場所を、端末のドキュメントとして見せる提供元。システムだけが直接つなげる(MANAGE_DOCUMENTS) -->
        <provider
            android:name=".network.NetworkProvider"
            android:authorities="${applicationId}.network"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
        <!-- ホーム画面のウィジェット(縦長・横長) -->
        <receiver
            android:name=".PlayerWidgetTall"
            android:exported="false"
            android:label="@string/widget_tall_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_tall_info" />
        </receiver>
        <receiver
            android:name=".PlayerWidgetWide"
            android:exported="false"
            android:label="@string/widget_wide_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_wide_info" />
        </receiver>

        <!-- Android Auto(試験的): 車の画面にライブラリを出す -->
        <service
            android:name=".AutoService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|mediaPlayback" />

        <!-- 内蔵 DAC の調べ物: メーカーのライブラリを読み込めるかを、別のプロセスで試す(万一そこで落ちても、アプリ本体は落ちない) -->
        <service
            android:name=".player.VendorLibProbeService"
            android:exported="false"
            android:process=":libprobe" />

        <!-- アップサンプルのタブの変換 -->
        <service
            android:name=".ConvertService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProcessing" />

        <!-- DAC を常に起こしておく(試験的。ほかのアプリの再生にも効く) -->
        <service
            android:name=".player.DacKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- ほかの音楽アプリの再生を表示・操作するため(「通知へのアクセス」の許可に使う。通知の中身は読まない) -->
        <service
            android:name=".player.MediaListenerService"
            android:exported="true"
            android:label="@string/launcher_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
