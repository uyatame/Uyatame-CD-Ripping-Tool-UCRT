        </activity-alias>
        <activity-alias
            android:name=".LauncherAlias_ucrt2_dark"
            android:enabled="false"
            android:exported="true"
            android:label="@string/launcher_name"
            android:icon="@mipmap/ic_alt_ucrt2_dark"
            android:roundIcon="@mipmap/ic_alt_ucrt2_dark"
            android:targetActivity=".MainActivity">
            <intent-filter>
